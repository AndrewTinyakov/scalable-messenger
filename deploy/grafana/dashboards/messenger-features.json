          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(kind,outcome)(rate(messenger_message_mutations_total[$__rate_interval]))",
          "legendFormat": "{{kind}} {{outcome}}",
