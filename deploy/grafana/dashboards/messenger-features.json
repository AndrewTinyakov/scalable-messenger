          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(messenger_deletion_acceptance_seconds_count{scope=\"everyone\",target=\"chat\"}[5m]))",
          "legendFormat": "{{outcome}}",
