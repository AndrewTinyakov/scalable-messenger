    },
    {
      "id": 12,
      "title": "Firing and pending alerts at range end",
      "type": "table",
      "description": "Snapshot at the selected range end. The no-active-alerts row appears only when the result has no firing or pending alerts. Use Alertmanager for live notification state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=~\"firing|pending\"} or on() label_replace(vector(0),\"alertname\",\"No active or pending alerts\",\"\",\"\")",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "job": "Service",
              "instance": "Target",
              "queue": "Queue"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Scrape coverage by service",
      "type": "table",
      "description": "Healthy targets versus configured minimum. Minimums allow additional autoscaled replicas but do not know an external scheduler's desired count. Values are snapshots at the selected range end. With To=now, failed or missing target states appear after rule evaluation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Shortfall"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Shortfall",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "messenger:minimum_scrape_targets",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "sum by(job)(up) or on(job) (0*messenger:minimum_scrape_targets)",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "messenger:unavailable_scrape_targets",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "job": "Service",
              "Value #A": "Minimum",
              "Value #B": "Healthy",
              "Value #C": "Shortfall"
            }
          }
        }
      ]
    },
    {
      "id": 103,
      "title": "Traffic and failures",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 14,
      "title": "Product API traffic",
      "type": "timeseries",
      "description": "Excludes actuator scrapes, so monitoring cannot create user traffic or dilute errors. No series when API scrape telemetry is unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"api\",uri!~\".*/actuator(/.*)?\"}[$__rate_interval])) or vector(0)) and on() (max(up{job=\"api\"})==1)",
          "legendFormat": "all product requests",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"api\",uri!~\".*/actuator(/.*)?\",status=~\"5..\"}[$__rate_interval])) or vector(0)) and on() (max(up{job=\"api\"})==1)",
          "legendFormat": "5xx",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-backend/messenger-backend",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 15,
      "title": "Saved, rejected and duplicate sends",
      "type": "timeseries",
      "description": "A duplicate is a resolved retry, not another durable message. Rejections can be expected membership or input outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(messenger_command_result_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-backend/messenger-backend",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 16,
      "title": "Gateway send and dependency errors",
      "type": "timeseries",
      "description": "Lazy counters may be absent until the first event. PUBLISH_UNKNOWN can later save and must be retried with the same request ID.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(code)(rate(messenger_ws_error_frames_total{code=~\"DEPENDENCY_UNAVAILABLE|PUBLISH_FAILED|PUBLISH_UNKNOWN|RATE_LIMITED\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-websocket/messenger-websocket",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 104,
      "title": "Backlogs and recovery",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 17,
      "title": "Rabbit ready and unacknowledged commands",
      "type": "timeseries",
      "description": "Deduplicates quorum-replica observations. Ready is queued; unacknowledged includes processing before commit/ACK.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by(queue)(rabbitmq_detailed_queue_messages_ready{queue=~\"messenger.send.[0-3]\"})",
          "legendFormat": "{{queue}} ready",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "max by(queue)(rabbitmq_detailed_queue_messages_unacked{queue=~\"messenger.send.[0-3]\"})",
          "legendFormat": "{{queue}} processing",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-backend/messenger-backend",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 18,
      "title": "Outbox age and publication latency",
      "type": "timeseries",
      "description": "Age describes the outstanding backlog; publication timing counts attempted events. Check sampler health if the age is stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(messenger_outbox_oldest_age_seconds)",
          "legendFormat": "oldest pending age",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(messenger_outbox_publication_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Redis publication p95",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-backend/messenger-backend",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 19,
      "title": "Recovery and ACK deadline events",
      "type": "timeseries",
      "description": "SQL fallback is expected when Redis cannot prove replay continuity. Rising fallback together with feed errors needs investigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(messenger_ws_sql_fallback_total[$__rate_interval]))",
          "legendFormat": "SQL fallback",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum(rate(messenger_ws_ack_timeouts_total[$__rate_interval]))",
          "legendFormat": "ACK deadline",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-websocket/messenger-websocket",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 105,
      "title": "Container resources: latest live incarnation",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 20,
      "title": "Current container CPU",
      "type": "timeseries",
      "description": "Latest container incarnation per Docker name with a fresh cAdvisor observation. One core equals one CPU-second per second. Container project only filters this resource section.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(name)(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"$project\",image!=\"\"}[$__rate_interval]) and on(id) ((container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\",image!=\"\"} == on(name) group_left max by(name)(container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\",image!=\"\"})) and on(id) (time()-container_last_seen{container_label_com_docker_compose_project=~\"$project\",image!=\"\"}<15)))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 21,
      "title": "Current container memory working set",
      "type": "timeseries",
      "description": "Latest fresh container ID per Docker name prevents recreations from creating duplicate current-resource lines. These are Linux VM metrics, not macOS memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by(name)(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\",image!=\"\"} and on(id) ((container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\",image!=\"\"} == on(name) group_left max by(name)(container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\",image!=\"\"})) and on(id) (time()-container_last_seen{container_label_com_docker_compose_project=~\"$project\",image!=\"\"}<15)))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 22,
      "title": "Docker VM CPU utilization",
      "type": "timeseries",
      "description": "Measured root CPU time divided by VM cores. Replaces the unsupported load-average signal. Includes other containers in the Docker VM; does not measure macOS host CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\",job=\"containers\"}[$__rate_interval])) / max(machine_cpu_cores{job=\"containers\"})",
          "legendFormat": "VM CPU",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Container project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{container_label_com_docker_compose_project=~\"messenger.*\",image!=\"\"},container_label_com_docker_compose_project)",
          "refId": "project"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": true,
        "allValue": "messenger.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
