  "description": "Operational triage for the local Messenger deployment. Scrape coverage, workload and timing boundaries are distinct signals.",
  "uid": "messenger-features",
  "title": "Messenger chat features",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Presence and node aggregation",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Active watches and shared peers",
      "description": "References count socket-to-peer watches; targets count unique peers queried once per node. Compare them to see node-level query sharing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(messenger_ws_presence_watches)",
          "legendFormat": "watch sets",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum(messenger_ws_presence_references)",
          "legendFormat": "peer references",
          "refId": "B",
          "instant": false
        },
        {
          "expr": "sum(messenger_ws_presence_targets)",
          "legendFormat": "unique peer targets",
          "refId": "C",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Presence query p95 and p99",
      "description": "Redis batches contain at most100 unique peers with bounded worker concurrency. Empty charts mean no observation, rather than zero latency.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(messenger_ws_presence_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(messenger_ws_presence_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Snapshot and authorization outcomes",
      "description": "Failed snapshots produce unknown status. Authorization is rechecked before the30-second grant expires; missing or expired grants stop delivery.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(messenger_ws_presence_snapshots_total[$__rate_interval]))",
          "legendFormat": "snapshot {{result}}",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum by(result)(rate(messenger_ws_presence_authorization_seconds_count[$__rate_interval]))",
          "legendFormat": "authorization {{result}}",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Presence changes and delivered heartbeats",
      "description": "State counters count changes; feature deliveries also include empty freshness heartbeats. No user or chat ID labels.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(state)(rate(messenger_ws_presence_states_total[$__rate_interval]))",
          "legendFormat": "{{state}} changes",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum(rate(messenger_ws_feature_deliveries_total{type=\"presence\"}[$__rate_interval]))",
          "legendFormat": "presence frames",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Presence sweep duration",
      "description": "One node-owned sweep joins all bounded workers; long sweeps can delay the next observation. Client freshness expires after15seconds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(messenger_ws_presence_sweep_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 sweep",
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Watch query sharing",
      "description": "Ratio of authorized peer references to unique queried peers across the fleet. A value above1 represents deduplicated repeated watches.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(messenger_ws_presence_references) / clamp_min(sum(messenger_ws_presence_targets),1)",
          "legendFormat": "references / unique peers",
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Human reads and retained timestamp ranges",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "Read advances and retries",
      "description": "Account frontiers advance monotonically. Repeated or backward progress is unchanged and inserts no timestamp ranges.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(messenger_read_advances_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum by(status)(rate(http_server_requests_seconds_count{job=\"api\",uri=~\".*/reads\",status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Read request p95 and p99",
      "description": "HTTP latency per read route from Spring request metrics, plus the duration of each expired timestamp cleanup batch.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,method,uri)(rate(http_server_requests_seconds_bucket{job=\"api\",uri=~\".*/reads\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}} p95",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le,method,uri)(rate(http_server_requests_seconds_bucket{job=\"api\",uri=~\".*/reads\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}} p99",
          "refId": "B",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(messenger_read_cleanup_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cleanup p95",
          "refId": "C",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(messenger_read_cleanup_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cleanup p99",
          "refId": "D",
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Timestamp writes per advance",
      "description": "Creation-day intervals insert up to8 rows per new prefix and avoid expanding crossed message sequences. This is an attempt-level ratio; transaction outcome panels reveal rollbacks.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(messenger_read_ranges_inserted_total[$__rate_interval])) / clamp_min(sum(rate(messenger_read_advances_total{outcome=\"advanced\"}[$__rate_interval])),0.000001)",
          "legendFormat": "range rows / advance",
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "title": "Read invalidation coalescing",
      "description": "One invalidation per active chat per2-second bucket, independent of the number of readers. Direct chats publish to two personal rooms. A trailing refresh repairs same-bucket timing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(messenger_read_notifications_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum(rate(messenger_ws_feature_deliveries_total{type=\"reads_changed\"}[$__rate_interval]))",
          "legendFormat": "socket invalidations",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "title": "Expired timestamp cleanup",
      "description": "Each coordinated cleanup transaction deletes bounded indexed batches. Old timestamp details are suppressed by message creation age even while cleanup lags.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(kind)(rate(messenger_read_cleanup_rows_total[$__rate_interval]))",
          "legendFormat": "{{kind}} rows",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "sum by(outcome)(rate(messenger_read_cleanup_batches_total[$__rate_interval]))",
          "legendFormat": "{{outcome}} batches",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 14,
      "title": "Expired range backlog and lag",
      "description": "Maximum across replica samples, with each backlog sample capped at10001 rows. Oldest expiry age is seconds; inspect both units when assessing a cleanup backlog.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest expired seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(messenger_read_cleanup_backlog)",
          "legendFormat": "expired rows, capped10001",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "max(messenger_read_cleanup_oldest_age_seconds)",
          "legendFormat": "oldest expired seconds",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 15,
      "title": "Message mutations, deletion and recovery",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 16,
      "title": "Edit outcomes",
      "description": "Author-only edits with expected-version checks. Scoped deletion has separate acceptance and purge panels.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
