    {
      "id": 18,
      "title": "Outbox publication age p95 and p99",
      "description": "Time from durable event creation to publication attempt, including outbox backlog. Message bodies are hydrated only for ephemeral live publication.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(messenger_outbox_publication_age_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(messenger_outbox_publication_age_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B",
          "instant": false
        }
      ]
    },
    {
      "id": 19,
      "title": "Feature frame delivery",
      "description": "Successfully written frames, including coalesced read invalidations and approximate presence snapshots. Compare frame rates with database writes and gateway fanout.",
      "type": "timeseries",
      "datasource": {
