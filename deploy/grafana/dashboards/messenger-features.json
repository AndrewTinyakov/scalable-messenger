    {
      "id": 17,
      "title": "Global chat deletion acceptance outcomes",
      "description": "Accepted or failed everyone-scope chat deletion requests across API replicas. Acceptance closes the identity; physical purge completes separately.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
