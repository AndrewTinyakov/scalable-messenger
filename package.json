{
  "name": "messenger",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "start:worker": "tsx apps/server/src/main-worker.ts",
    "start:relay": "tsx apps/server/src/main-relay.ts",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "db:seed": "tsx apps/server/src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts",
    "format": "prettier --write apps packages scripts *.json *.md *.yml *.ts",
    "format:check": "prettier --check apps packages scripts *.json *.md *.yml *.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "start:api-gateway": "tsx apps/server/src/main-api-gateway.ts",
    "start:ws-gateway": "tsx apps/server/src/main-ws-gateway.ts",
    "test:cluster": "tsx scripts/test-cluster.ts",
    "cluster:up": "docker compose -f compose.yml -f compose.app.yml up -d --build",
    "cluster:down": "docker compose -f compose.yml -f compose.app.yml down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "amqplib": "^2.0.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.21.3"
  }
}
