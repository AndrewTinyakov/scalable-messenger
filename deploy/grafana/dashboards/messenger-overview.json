    {
      "id": 10,
      "title": "SQL save to gateway latency",
      "type": "timeseries",
      "description": "SQL creation to gateway room handling. Includes outbox and Redis. Excludes browser network and rendering. A blank percentile during zero traffic means no observations; check volume and scrape coverage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(messenger_ws_saved_event_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(messenger_ws_saved_event_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "links": [
        {
          "title": "Investigate",
          "url": "/d/messenger-websocket/messenger-websocket",
          "includeVars": true,
          "keepTime": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Before SQL: where sends wait",
      "type": "timeseries",
      "description": "Stages overlap and percentiles cannot be added. Wire-to-confirm includes transport and scheduling. Use the detailed dashboards to compare SQL locking and commit.",
