{
  "name": "messenger",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "generate:openapi": "./api/gradlew -p api generateOpenApiDocs && npm --prefix client run generate:api",
    "validate:asyncapi": "asyncapi validate contracts/asyncapi.yaml && asyncapi validate contracts/models.asyncapi.yaml",
    "generate:asyncapi:kotlin": "node contracts/generate-models.mjs kotlin",
    "generate:asyncapi:go": "node contracts/generate-models.mjs go",
    "test:contracts": "node --test contracts/fixtures.test.mjs",
    "typecheck:client": "npm --prefix client run typecheck",
    "monitoring:check": "node scripts/check-monitoring.mjs",
    "monitoring:dashboards": "python3 scripts/generate-monitoring-dashboards.py",
    "test:system": "node --test --test-concurrency=1 tests/system/*.test.mjs",
    "test:resilience": "MESSENGER_RESILIENCE=1 node --test --test-concurrency=1 tests/system/*.test.mjs"
  },
  "devDependencies": {
    "@asyncapi/cli": "6.1.0"
  }
}
